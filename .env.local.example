# ============================================================
# Environment Variables — Futuro Me
# ============================================================
# NEXT_PUBLIC_ prefix = exposed to the browser (safe if RLS is on)
# No prefix = server-only (API routes, cron jobs, server actions)
# ============================================================

# --- Supabase ---
# Browser client (safe: restricted by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only client with elevated privileges (bypasses RLS)
# Used in API routes and cron jobs. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Authentication ---
# Vercel cron job secret (validated in /api/cron/* routes)
CRON_SECRET=your-cron-secret

# Admin secret: /api/admin/* routes and login to the /admin news console
# (falls back to CRON_SECRET). Use a long random value: openssl rand -hex 32
ADMIN_SECRET=your-admin-secret

# --- Weekly news job (see docs/news-automation.md) ---
# Claude API key used to choose and summarize the weekly news (server-only).
# Without it the job still publishes, using short extracts of the sources.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: max news published per week (default 6) and summary model.
NEWS_MAX_PER_WEEK=6
# NEWS_SUMMARY_MODEL=claude-opus-5-5

# --- Site Configuration ---
# Public base URL (used for sitemap, canonical URLs, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://ilfuturome.it
